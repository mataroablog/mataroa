{
  "name": "mataroa-chatgpt-library",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A read-only Mataroa post library for the ChatGPT MCP App sidebar.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node web/build.mjs",
    "typecheck": "tsc --noEmit -p web/tsconfig.json",
    "test": "node --experimental-strip-types --test web/tests/*.test.ts web/tests/*.test.mjs",
    "test:ui": "node web/tests/browser.mjs",
    "preview": "node web/preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openai/mcp-extensions": "0.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.0",
    "esbuild": "0.28.1",
    "jsdom": "30.1.2",
    "typescript": "5.9.3"
  }
}
